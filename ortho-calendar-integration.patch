+function socEsc(t){ return String(t||"").replace(/\\/g,"\\\\").replace(/;/g,"\\;").replace(/,/g,"\\,").replace(/\n/g,"\\n"); }
+function socIcs(evs){
+  const L = ["BEGIN:VCALENDAR","VERSION:2.0","PRODID:-//Ortho Digest//JA","CALSCALE:GREGORIAN","METHOD:PUBLISH"];
+  evs.forEach(e=>{
+    const desc = [
+      "会場："+e.venue+"（"+e.city+"）",
+      "参加登録："+(e.reg?socRange(e.reg):"未発表"),
+      e.abs?"演題登録："+socRange(e.abs):"",
+      e.president?"会長："+e.president:"",
+      e.theme?"テーマ："+e.theme:"",
+      e.url
+    ].filter(Boolean).join("\n");
+    L.push("BEGIN:VEVENT",
+      "UID:"+e.id+"@ortho-digest",
+      "DTSTAMP:"+new Date().toISOString().replace(/[-:]/g,"").split(".")[0]+"Z",
+      "DTSTART;VALUE=DATE:"+e.start.replace(/-/g,""),
+      "DTEND;VALUE=DATE:"+socNextDay(e.end).replace(/-/g,""),
+      "SUMMARY:"+socEsc(e.ed+" "+e.name),
