name: 整形外科論文ニュース取得（毎日）

on:
  schedule:
    - cron: '0 19 * * *'   # 毎日 4:00 JST
  workflow_dispatch:

permissions:
  contents: write

jobs:
  fetch-papers:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v6
        with:
          python-version: '3.11'
      - env:
          GOOGLE_API_KEY: ${{ secrets.GOOGLE_API_KEY }}
        run: python fetch_news.py
      - run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add news.json details.json
          git diff --staged --quiet || (git commit -m "📰 論文ニュース更新 $(TZ=Asia/Tokyo date '+%Y-%m-%d')" && git pull --rebase && git push)
