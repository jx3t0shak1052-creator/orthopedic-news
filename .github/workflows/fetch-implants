name: 国内インプラントメーカーニュース取得（毎週月曜）

on:
  schedule:
    - cron: '30 21 * * 0'
  workflow_dispatch:

concurrency:
  group: orthopedic-news-push
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  fetch-implants:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v6
        with:
          python-version: '3.11'
      - env:
          GOOGLE_API_KEY: ${{ secrets.GOOGLE_API_KEY }}
        run: python fetch_implant_news.py
      - run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add implant_news.json
          if git diff --staged --quiet; then
            echo "変更なし。スキップします。"
          else
            git commit -m "🏭 インプラントニュース更新 $(TZ=Asia/Tokyo date '+%Y-%m-%d')"
            for i in 1 2 3; do
              git push origin main && break
              echo "Push失敗 (試行 $i)。pull --rebase してリトライ..."
              git pull --rebase origin main
              sleep 5
            done
          fi
